<Window x:Class="FormatFactory.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FormatFactory · Video Studio" Width="1120" Height="820" MinWidth="850" MinHeight="650" Background="#F3F6FB" FontFamily="Segoe UI" Loaded="OnLoaded" Closing="OnClosing">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="FORMAT FACTORY" FontSize="13" FontWeight="Bold" Foreground="#3474C8"/><TextBlock Text="Video to words." FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Extract audio and transcribe locally with FFmpeg + Whisper." Foreground="#66758A"/></StackPanel>
  <Border Grid.Row="1" Background="White" Padding="16" CornerRadius="12" Margin="0,0,0,16"><StackPanel>
   <DockPanel><Button x:Name="CheckButton" Content="Check tools" DockPanel.Dock="Right" Click="CheckTools"/><TextBlock Text="01  /  Your tools" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <ItemsControl x:Name="ToolsList"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><Button Content="{Binding Action}" Tag="{Binding Key}" Click="InstallTool" DockPanel.Dock="Right" IsEnabled="{Binding CanInstall}" Width="130"/><TextBlock Text="{Binding Name}" Width="130" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border>
  <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="White" Padding="16" CornerRadius="12"><StackPanel>
    <TextBlock Text="02  /  Transcribe a video" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <DockPanel><Button x:Name="BrowseButton" Content="Choose video…" DockPanel.Dock="Right" Click="Browse"/><TextBox x:Name="VideoPath" IsReadOnly="True" VerticalContentAlignment="Center"/></DockPanel>
    <DockPanel Margin="0,8,0,0"><Button x:Name="OutputButton" Content="Output folder…" DockPanel.Dock="Right" Click="ChooseOutput"/><TextBox x:Name="OutputPath" IsReadOnly="True" VerticalContentAlignment="Center"/></DockPanel>
    <WrapPanel Margin="0,10,0,0"><TextBlock Text="Model" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="Model" Width="100" SelectedIndex="1"><ComboBoxItem Content="tiny"/><ComboBoxItem Content="base"/><ComboBoxItem Content="small"/><ComboBoxItem Content="medium"/><ComboBoxItem Content="large"/></ComboBox><TextBlock Text="Language" VerticalAlignment="Center" Margin="16,0,8,0"/><ComboBox x:Name="LanguageChoice" Width="130" SelectedIndex="0"><ComboBoxItem Content="Auto detect" Tag=""/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Spanish" Tag="es"/><ComboBoxItem Content="French" Tag="fr"/><ComboBoxItem Content="German" Tag="de"/><ComboBoxItem Content="Italian" Tag="it"/><ComboBoxItem Content="Portuguese" Tag="pt"/></ComboBox><Button x:Name="StartButton" Content="Start transcription" Background="#2467C5" Foreground="White" Click="Start"/><Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="Cancel"/></WrapPanel>
    <TextBlock Text="First use downloads the selected model. Larger models need more memory and time." Foreground="#66758A" Margin="0,8,0,0"/>
   </StackPanel></Border>
   <StackPanel Grid.Row="1" Margin="0,14"><DockPanel><TextBlock x:Name="Stage" Text="Ready" FontWeight="SemiBold"/><TextBlock x:Name="Estimate" DockPanel.Dock="Right" TextAlignment="Right"/></DockPanel><ProgressBar x:Name="Progress" Height="8" Maximum="100" Margin="0,8" Foreground="#2467C5"/></StackPanel>
   <TabControl Grid.Row="2"><TabItem Header="Transcription"><TextBox x:Name="Transcript" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem><TabItem Header="Live log"><TextBox x:Name="Log" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem></TabControl>
  </Grid>
  <TextBlock Grid.Row="3" Text="Local processing • MP3, TXT and SRT saved in a unique output folder" Foreground="#66758A" Margin="0,12,0,0"/>
 </Grid>
</Window>
